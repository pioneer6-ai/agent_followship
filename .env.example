# Patient Follow-up Agent - environment template
#
# Copy to `.env` and fill in what you need:
#     cp .env.example .env
#
# Nothing is sent for real until MESSAGING_DRY_RUN=0 AND the channel is
# configured. A channel that is not configured never transmits, so a
# partially-filled file is safe to run.

# ---------------------------------------------------------------------------
# Global
# ---------------------------------------------------------------------------

# Force dry-run on (1) or off (0).
# LIVE SENDING IS OFF UNTIL YOU SET THIS TO 0. Without it (or with 1/true/yes)
# every send is simulated, even when credentials are present, so this file can
# never message a real patient by accident.
MESSAGING_DRY_RUN=1

# Per-request timeout in seconds (float).
MESSAGING_TIMEOUT_SECONDS=10

# Dial code prepended to phone numbers given in local form, e.g. "91234567".
MESSAGING_DEFAULT_COUNTRY_CODE=65

# ---------------------------------------------------------------------------
# WhatsApp - choose the provider: meta | twilio | none
# ---------------------------------------------------------------------------

WHATSAPP_PROVIDER=meta

# --- Meta (WhatsApp Cloud API) ---
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0
META_TEMPLATE_LANGUAGE=en

# --- Twilio (WhatsApp and/or SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, including the prefix, e.g. "whatsapp:+14155238886"
TWILIO_WHATSAPP_FROM=
# SMS sender, e.g. "+14155238886"
TWILIO_SMS_FROM=
# JSON map of template name -> Twilio ContentSid, e.g.
#   TWILIO_CONTENT_SIDS={"appointment_reminder":"HXaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
TWILIO_CONTENT_SIDS=
# 1 = refuse to send a WhatsApp message when no ContentSid is mapped
# (required for business-initiated messages outside a 24h customer window).
TWILIO_REQUIRE_CONTENT_SID=0

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# 16 characters for an app password; Gmail's display spaces are tolerated.
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
# Falls back to SMTP_USERNAME when empty.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# AWS messaging backends (tools: send_sms, send_email)
# ---------------------------------------------------------------------------
# PIP INSTALL BOTO3 FIRST, otherwise both AWS tools report "config_missing".
#
# send_sms uses AWS End User Messaging SMS (pinpoint-sms-voice-v2) and
# send_email uses Amazon SES. Credentials come from the normal boto3 chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, SSO, or an
# instance role) -- never put them here.
AWS_REGION=ap-southeast-1

# Sender for send_email. Must be an SES-verified identity; while the account is
# in the SES sandbox every recipient must also be verified.
#
# Sending from the recipient's own domain (as below) is fine for smoke tests but
# lands in spam, because the message carries no DKIM signature for the domain it
# claims to come from. For real use, verify a domain you own -- see
# scripts/ses_domain_setup.py and the Deliverability section of README.md --
# then set this to an address at that domain, e.g. reminders@clinic.example.com.
AWS_SES_SOURCE=martinchenonly1@gmail.com

# Optional SES configuration set. Set it to make delivery verifiable: SES then
# publishes per-send Delivery/Bounce/Complaint events (CloudWatch metrics and/or
# an SNS event destination), so "accepted" can be told apart from "delivered".
AWS_SES_CONFIGURATION_SET=

# Optional SMS sender (long code, short code, sender ID or pool ARN). The API
# treats it as optional, but real deliveries generally need it.
AWS_SMS_ORIGINATION_IDENTITY=

# Verified-recipient allow-lists, comma separated. The AWS tools REFUSE to
# transmit to anything else (error_code "recipient_not_verified") because
# sandboxed accounts can only reach verified destinations. Setting either
# variable replaces its default; an empty value denies every recipient.
AWS_SMS_ALLOWED_NUMBERS=+6583536885
AWS_EMAIL_ALLOWED_ADDRESSES=martinchenonly1@gmail.com

# ---------------------------------------------------------------------------
# LLM (only needed for live Claude tool use: pip install anthropic)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Agent layer (the patient follow-up loop itself)
# ---------------------------------------------------------------------------

# Second, independent switch required before the AGENT (not just the tools)
# sends anything for real. MESSAGING_DRY_RUN=0 alone is not enough: a populated
# .env must never turn `python demo.py` into a machine that texts real patients.
# Set both only when you intend the agent to transmit.
AGENT_LIVE_SENDS=

# Staff address to alert when a case is escalated. When empty, escalations are
# still recorded on the case and in the audit log, but no email is sent.
AGENT_ESCALATION_EMAIL=

# Claude model used for the agent's DECIDE step when ANTHROPIC_API_KEY is set.
# The LLM may only choose actions the rule engine permits, and falls back to the
# rules whenever it is unavailable or answers out of bounds.
AGENT_DECISION_MODEL=claude-sonnet-4-5
