# Patient Follow-up Agent - environment template
#
# Copy to `.env` and fill in what you need:
#     cp .env.example .env
#
# Nothing is sent for real until MESSAGING_DRY_RUN=0 AND the channel is
# configured. A channel that is not configured never transmits, so a
# partially-filled file is safe to run.

# ---------------------------------------------------------------------------
# Global
# ---------------------------------------------------------------------------

# Force dry-run on (1) or off (0).
# LIVE SENDING IS OFF UNTIL YOU SET THIS TO 0. Without it (or with 1/true/yes)
# every send is simulated, even when credentials are present, so this file can
# never message a real patient by accident.
MESSAGING_DRY_RUN=1

# Per-request timeout in seconds (float).
MESSAGING_TIMEOUT_SECONDS=10

# Dial code prepended to phone numbers given in local form, e.g. "91234567".
MESSAGING_DEFAULT_COUNTRY_CODE=65

# Which file load_env_file() reads. Empty means ./.env. Set it when the clinic
# keeps its secrets outside the repository, e.g. /etc/brightsmile/agent.env.
MESSAGING_ENV_FILE=

# Optional path to a CA bundle, honoured by this project's TLS helper. Set it
# if you hit CERTIFICATE_VERIFY_FAILED, e.g. /etc/ssl/cert.pem.
SSL_CERT_FILE=

# ---------------------------------------------------------------------------
# WhatsApp - choose the provider: meta | twilio | none
# ---------------------------------------------------------------------------

WHATSAPP_PROVIDER=meta

# --- Meta (WhatsApp Cloud API) ---
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0
META_TEMPLATE_LANGUAGE=en

# --- Twilio (WhatsApp and/or SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, including the prefix, e.g. "whatsapp:+14155238886"
TWILIO_WHATSAPP_FROM=
# SMS sender, e.g. "+14155238886"
TWILIO_SMS_FROM=
# JSON map of template name -> Twilio ContentSid, e.g.
#   TWILIO_CONTENT_SIDS={"appointment_reminder":"HXaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
TWILIO_CONTENT_SIDS=
# 1 = refuse to send a WhatsApp message when no ContentSid is mapped
# (required for business-initiated messages outside a 24h customer window).
TWILIO_REQUIRE_CONTENT_SID=0

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# 16 characters for an app password; Gmail's display spaces are tolerated.
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
# Falls back to SMTP_USERNAME when empty.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# AWS messaging backends (tools: send_sms, send_email)
# ---------------------------------------------------------------------------
# PIP INSTALL BOTO3 FIRST, otherwise both AWS tools report "config_missing".
#
# send_sms uses AWS End User Messaging SMS (pinpoint-sms-voice-v2) and
# send_email uses Amazon SES. Credentials come from the normal boto3 chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, SSO, or an
# instance role) -- never put them here.
AWS_REGION=ap-southeast-1
# Fallback region, read only when AWS_REGION is unset.
AWS_DEFAULT_REGION=

# Sender for send_email. Must be an SES-verified identity; while the account is
# in the SES sandbox every recipient must also be verified.
#
# Sending from the recipient's own domain (as below) is fine for smoke tests but
# lands in spam, because the message carries no DKIM signature for the domain it
# claims to come from. For real use, verify a domain you own -- see
# scripts/ses_domain_setup.py and the Deliverability section of README.md --
# then set this to an address at that domain, e.g. reminders@clinic.example.com.
AWS_SES_SOURCE=martinchenonly1@gmail.com

# Optional SES configuration set. Set it to make delivery verifiable: SES then
# publishes per-send Delivery/Bounce/Complaint events (CloudWatch metrics and/or
# an SNS event destination), so "accepted" can be told apart from "delivered".
AWS_SES_CONFIGURATION_SET=

# Optional SMS sender (long code, short code, sender ID or pool ARN). The API
# treats it as optional, but real deliveries generally need it.
AWS_SMS_ORIGINATION_IDENTITY=

# Verified-recipient allow-lists, comma separated. The AWS tools REFUSE to
# transmit to anything else (error_code "recipient_not_verified") because
# sandboxed accounts can only reach verified destinations. Setting either
# variable replaces its default; an empty value denies every recipient.
AWS_SMS_ALLOWED_NUMBERS=+6583536885
AWS_EMAIL_ALLOWED_ADDRESSES=martinchenonly1@gmail.com

# ---------------------------------------------------------------------------
# LLM (only needed for live Claude tool use: pip install anthropic)
# ---------------------------------------------------------------------------

# Credential fallbacks, tried in this order by the LLM layer:
#   AGENT_LLM_API_KEY  ->  LLM_API_KEY  ->  the vendor variable below.
# Setting AGENT_LLM_API_KEY is preferred; these exist so an established naming
# convention keeps working unchanged.
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Bring your own LLM (hospital_setup.py --check proves it works)
# ---------------------------------------------------------------------------
#
# A hospital does not have to use Claude. Set AGENT_LLM_PROVIDER to any of:
#   anthropic | openai | azure | openai-compatible | ollama | disabled
#
# "openai-compatible" is the catch-all for a self-hosted or in-house gateway
# (vLLM, LiteLLM, TGI, an internal proxy): supply the base URL up to but NOT
# including /chat/completions. An unrecognised provider name degrades to
# anthropic rather than failing, so a typo cannot take the agent offline.
#
# The model may only choose among the actions the rule engine permits, and any
# error (bad key, timeout, out-of-bounds answer) falls back to the rules. An
# LLM is therefore never a single point of failure.

AGENT_LLM_PROVIDER=anthropic
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=
# Azure only: the api-version query parameter.
AGENT_LLM_API_VERSION=
# OpenAI only: routes requests to a specific organisation.
AGENT_LLM_ORGANIZATION=
# JSON object, e.g. {"X-Tenant-Id": "clinic-a"} -- for gateways that need it.
AGENT_LLM_EXTRA_HEADERS=
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Bring your own domain mailbox (the clinic's already-maintained address)
# ---------------------------------------------------------------------------
#
# These settings drive the SMTP channel (`send_email_message`). The clinic signs
# in with an existing mailbox on its own domain and the agent sends patient mail
# from it, so the mail is signed by the clinic's own provider and keeps the
# clinic's reputation.
#
# THE VARIABLES THEMSELVES ARE DECLARED ONCE, in the "Email (SMTP)" section
# above: SMTP_HOST, SMTP_PORT, SMTP_USE_TLS, SMTP_USE_SSL, SMTP_USERNAME,
# SMTP_PASSWORD and EMAIL_FROM. Fill them in there. Do not re-declare a variable
# in a second place: a later empty declaration silently blanks an earlier one
# when a caller loads the file with override=True.
#
# There is NO SMTP_PRESET environment variable. Presets are a convenience of
# `hospital_setup.py` (the EMAIL.preset field), which resolves a provider name
# into the concrete SMTP_* values above when you call apply().
#
# Common providers (used when you set EMAIL.preset in hospital_setup.py):
#   provider        host                                      port  encryption
#   microsoft365    smtp.office365.com                        587   STARTTLS
#   google          smtp.gmail.com                            587   STARTTLS
#   exmail          smtp.exmail.qq.com                        465   SSL
#   aliyun          smtp.qiye.aliyun.com                      465   SSL
#   zoho            smtp.zoho.com                             587   STARTTLS
#   fastmail        smtp.fastmail.com                         587   STARTTLS
#   workmail        smtp.mail.us-east-1.awsapps.com           465   SSL
#   ses             email-smtp.ap-southeast-1.amazonaws.com   587   STARTTLS
#
# The workmail and ses hosts are region-bound as shown; set SMTP_HOST yourself
# if your region differs.
#
# Gmail / Google Workspace needs a 16-character App Password (2FA required,
# https://myaccount.google.com/apppasswords) -- an ordinary account password
# will be refused. The agent accepts the usual "xxxx xxxx xxxx xxxx" spacing.
#
# NOTE: unlike the AWS tools, the SMTP channel enforces NO recipient allow-list.
# This mailbox can reach anyone its provider will relay to, so reputation and
# volume limits belong to the clinic's own mail provider. Keep
# MESSAGING_DRY_RUN=1 until the clinic is ready.

# The friendly display name patients see in their inbox (SMTP_* and EMAIL_FROM
# are declared in the section above).
EMAIL_FROM_NAME=

# ---------------------------------------------------------------------------
# Agent layer (the patient follow-up loop itself)
# ---------------------------------------------------------------------------

# Second, independent switch required before the AGENT (not just the tools)
# sends anything for real. MESSAGING_DRY_RUN=0 alone is not enough: a populated
# .env must never turn `python demo.py` into a machine that texts real patients.
# Set both only when you intend the agent to transmit.
AGENT_LIVE_SENDS=

# Staff address to alert when a case is escalated. When empty, escalations are
# still recorded on the case and in the audit log, but no email is sent.
AGENT_ESCALATION_EMAIL=

# Claude model used for the agent's DECIDE step when ANTHROPIC_API_KEY is set.
# The LLM may only choose actions the rule engine permits, and falls back to the
# rules whenever it is unavailable or answers out of bounds.
AGENT_DECISION_MODEL=claude-sonnet-4-5

# Clinic policy. A blank or non-numeric value falls back to the default rather
# than stopping the agent.
#
# How many unanswered reminders before a case escalates to a human.
AGENT_MAX_REMINDERS_BEFORE_ESCALATION=3
# Minimum days between reminders to the same patient.
AGENT_REMINDER_INTERVAL_DAYS=7
# A patient this many days overdue is classed HIGH urgency.
AGENT_HIGH_URGENCY_THRESHOLD_DAYS=30
# A patient this many days overdue is classed CRITICAL and escalates at once.
AGENT_CRITICAL_URGENCY_THRESHOLD_DAYS=60
